# ============================================================================
# TaiwanImportCheck - P0 技術驗證環境變數範本 (.env.example)
# 使用方式：
# - Docker Compose：複製到專案根目錄並命名為 .env
# - Windows 本機 Hermes：複製到隔離的 HERMES_HOME 並命名為 .env
# 切勿將任何實際 .env 提交至 Git。
# ============================================================================

# --- 1. Telegram Bot 與權限控管 (預設拒絕 Fail-Closed) ---
# 請向 @BotFather 申請測試用 Bot Token
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token

# 允許使用查詢工具的 Telegram User ID 清單（逗號分隔純數字 ID）
# 未設定或不在清單內的使用者將被 Hermes Gateway 與 Python 工具雙層拒絕
TELEGRAM_ALLOWED_USERS=replace_with_comma_separated_authorized_user_ids

# 允許執行管理動作（如資料狀態檢查）的 Telegram User ID 清單
ADMIN_TELEGRAM_USERS=replace_with_admin_user_id

# --- 2. Hermes Agent 與 LLM 設定 ---
# Docker Compose 專用：本機 Hermes v0.19.1 原始碼目錄絕對路徑
# 例如 Windows: C:/Users/your_name/AppData/Local/hermes/hermes-agent
HERMES_SOURCE_DIR=replace_with_absolute_path_to_hermes_agent_source

# Docker Compose 專用：容器初始化的檔案擁有者 UID/GID；Windows 通常保留預設值
HERMES_UID=10000
HERMES_GID=10000

# Compose 要讀取的秘密檔；本機驗證可暫時指向 .env.example，正式使用請改為 .env
HERMES_ENV_FILE=.env

# 啟用工作目錄下的 .hermes/plugins/ 本地插件
HERMES_ENABLE_PROJECT_PLUGINS=1

# LLM API 設定（依您實際在 Hermes 使用的供應商填寫，切勿外洩）
OPENAI_API_KEY=replace_with_your_llm_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名稱不放這裡；請在 config/config.yaml.example 的 model.default 設定。
# 每位使用者仍應自行確認模型供應商、費用及資料保留政策。

# --- 3. P0 本地測試資料庫與網路安全設定 ---
# 若未指定，預設使用 ./data/official_data/p0_mock_tariff.db（若不存在會自動建立測試假資料）
P0_MOCK_DB_PATH=./data/official_data/p0_mock_tariff.db

# 是否允許 Python 工具在通過 SSRF 檢查後，對外抓取商品 URL 網頁標題（預設 0 僅安全解析 URL，設為 1 可啟用限時限流抓取）
P0_ALLOW_LIVE_URL_FETCH=0
